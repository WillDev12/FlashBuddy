{
  "manifest_version": 3,
  "name": "FlashBuddy Extras",
  "version": "1.0.0",
  "description": "Import Quizlet decks directly into FlashBuddy",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://quizlet.com/*",
    "file://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://quizlet.com/*"],
      "js": ["content-quizlet.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["file://*/*"],
      "js": ["content-flashbuddy.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
